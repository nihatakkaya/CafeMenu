POSTGRES_DB=cafemenu
POSTGRES_USER=cafemenu_user
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_PORT=5433
REDIS_PORT=6379

API_HTTP_PORT=8080
WEB_HTTP_PORT=8081
API_ALLOWED_HOSTS=localhost;127.0.0.1;[::1];api
WEB_ALLOWED_HOSTS=localhost;127.0.0.1;[::1];web
PUBLIC_API_BASE_URL=http://api:8080
ADMIN_API_BASE_URL=http://api:8080
PUBLIC_MENU_BASE_URL=http://localhost:8081
HTTP_CLIENT_DEFAULT_TIMEOUT_SECONDS=15
ADMIN_SESSION_PROVIDER=Memory
ADMIN_SESSION_KEY_PREFIX=cafemenu:admin-session:
ADMIN_SESSION_REDIS_CONNECTION_STRING=redis:6379,abortConnect=false
DATA_PROTECTION_APPLICATION_NAME=CafeMenu.Web
DATA_PROTECTION_KEY_RING_PATH=
IMAGE_STORAGE_PROVIDER=Local
IMAGE_STORAGE_LOCAL_ROOT=/var/cafemenu/media
IMAGE_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/media
IMAGE_STORAGE_MAX_FILE_SIZE_BYTES=5242880
DATABASE_RETRY_ENABLED=true
DATABASE_RETRY_MAX_RETRY_COUNT=3
DATABASE_RETRY_MAX_RETRY_DELAY_SECONDS=5
REVERSE_PROXY_ENABLED=false
REVERSE_PROXY_FORWARD_LIMIT=1
RATE_LIMIT_LOGIN_PERMIT_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_PERMIT_LIMIT=60
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_ACCOUNT_SETUP_PERMIT_LIMIT=5
RATE_LIMIT_ACCOUNT_SETUP_WINDOW_SECONDS=300
RATE_LIMIT_PLATFORM_USER_SETUP_PERMIT_LIMIT=20
RATE_LIMIT_PLATFORM_USER_SETUP_WINDOW_SECONDS=60

ASPNETCORE_ENVIRONMENT=Development

JWT_ISSUER=CafeMenu.Development
JWT_AUDIENCE=CafeMenu.Api
JWT_SIGNING_KEY=replace_with_local_development_key_at_least_32_chars
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
