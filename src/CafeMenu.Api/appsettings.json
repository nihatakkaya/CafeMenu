{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "UserSetup": {
    "TokenExpirationHours": 24
  },
  "ImageStorage": {
    "Provider": "Local",
    "LocalRoot": "",
    "PublicBaseUrl": "",
    "MaxFileSizeBytes": 5242880
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "AccountSetup": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    },
    "PlatformUserSetup": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
