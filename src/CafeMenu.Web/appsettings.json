{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PublicApi": {
    "BaseUrl": "http://localhost:5279"
  },
  "PublicMenu": {
    "BaseUrl": "http://localhost:5161"
  },
  "AdminApi": {
    "BaseUrl": "http://localhost:5279"
  },
  "AdminSession": {
    "Provider": "Memory",
    "KeyPrefix": "cafemenu:admin-session:",
    "RedisConnectionString": "",
    "MinimumCacheTtlSeconds": 1
  },
  "DataProtection": {
    "ApplicationName": "CafeMenu.Web",
    "KeyRingPath": ""
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "AccountSetup": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    },
    "PlatformUserSetup": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
