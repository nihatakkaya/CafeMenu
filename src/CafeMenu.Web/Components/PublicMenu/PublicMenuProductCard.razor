@using System.Globalization

<article class="product-card @(Product.IsAvailable ? string.Empty : "is-unavailable")">
    @if (!string.IsNullOrWhiteSpace(Product.ImageUrl))
    {
        <img class="product-image" src="@Product.ImageUrl" alt="@Product.Name" loading="lazy" />
    }
    <div class="product-content">
        <div class="product-heading">
            <h3>
                <a href="@ProductDetailUrl">@Product.Name</a>
            </h3>
            <span class="product-price">@FormatPrice(Product.Price)</span>
        </div>
        @if (ShowCategoryName && !string.IsNullOrWhiteSpace(CategoryName))
        {
            <span class="product-category">@CategoryName</span>
        }
        @if (!string.IsNullOrWhiteSpace(Product.Description))
        {
            <p>@Product.Description</p>
        }
        @if (!Product.IsAvailable)
        {
            <span class="availability">Tükendi</span>
        }
    </div>
</article>

@code {
    private static readonly CultureInfo TurkishCulture = CultureInfo.GetCultureInfo("tr-TR");

    [Parameter]
    public PublicMenuProductResponse Product { get; set; } = new();

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Parameter]
    public string? CategoryName { get; set; }

    [Parameter]
    public bool ShowCategoryName { get; set; }

    private string ProductDetailUrl
    {
        get
        {
            var slug = Uri.EscapeDataString(Slug.Trim().ToLowerInvariant());
            return $"/c/{slug}/products/{Product.Id}";
        }
    }

    private static string FormatPrice(decimal price)
    {
        return $"{price.ToString("N2", TurkishCulture)} ₺";
    }
}
