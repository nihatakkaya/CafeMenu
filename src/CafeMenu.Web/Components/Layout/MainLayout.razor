@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="main-shell">
        <header class="app-topbar">
            <div>
                <span class="app-topbar-kicker">CafeMenu</span>
                <strong>Yönetim konsolu</strong>
            </div>
            <a href="/admin">Cafe seçimi</a>
        </header>
        <article class="content app-content">
