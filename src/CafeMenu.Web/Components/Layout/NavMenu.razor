@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-mark" aria-hidden="true">CM</span>
            <span>CafeMenu</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon" aria-hidden="true">⌂</span> Ana Sayfa
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <a class="@GetCafeNavClass()" href="admin" aria-current="@GetCafeAriaCurrent()">
                        <span class="nav-icon" aria-hidden="true">▦</span> Cafeler
                    </a>
                </div>
                <AuthorizeView Roles="PLATFORM_ADMIN">
                    <Authorized Context="platformAuth">
                        <div class="nav-item px-3">
                            <a class="@GetPlatformNavClass()" href="admin/platform" aria-current="@GetPlatformAriaCurrent()">
                                <span class="nav-icon" aria-hidden="true">◆</span> Platform
                            </a>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="nav-item px-3">
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link p-0">
                            <span class="nav-icon" aria-hidden="true">↩</span> Çıkış
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string CurrentRelativePath
    {
        get
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
            return relativePath.TrimEnd('/');
        }
    }

    private bool IsPlatformSection()
    {
        return CurrentRelativePath.Equals("admin/platform", StringComparison.OrdinalIgnoreCase) ||
            CurrentRelativePath.StartsWith("admin/platform/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCafeSection()
    {
        return CurrentRelativePath.Equals("admin", StringComparison.OrdinalIgnoreCase) ||
            CurrentRelativePath.StartsWith("admin/cafes/", StringComparison.OrdinalIgnoreCase);
    }

    private string GetCafeNavClass()
    {
        return IsCafeSection() ? "nav-link active" : "nav-link";
    }

    private string GetPlatformNavClass()
    {
        return IsPlatformSection() ? "nav-link active" : "nav-link";
    }

    private string? GetCafeAriaCurrent()
    {
        return IsCafeSection() ? "page" : null;
    }

    private string? GetPlatformAriaCurrent()
    {
        return IsPlatformSection() ? "page" : null;
    }
}
