@page "/c/{Slug}"
@layout PublicMenuLayout
@attribute [StreamRendering]
@inject IPublicMenuApiClient PublicMenuApiClient

<PageTitle>@(_menu?.CafeName ?? "Menü")</PageTitle>

@if (_status == PublicMenuPageStatus.Loading)
{
    <section class="public-menu-state loading-state" aria-live="polite">
        <div class="loading-mark"></div>
        <p>Menü yükleniyor...</p>
    </section>
}
else if (_status == PublicMenuPageStatus.NotFound)
{
    <section class="public-menu-state">
        <h1>Menü bulunamadı</h1>
        <p>Bu cafe menüsü yayında olmayabilir veya bağlantı artık geçerli olmayabilir.</p>
    </section>
}
else if (_status == PublicMenuPageStatus.Failure)
{
    <section class="public-menu-state">
        <h1>Menü yüklenemedi</h1>
        <p>Şu anda menüye erişilemiyor. Lütfen daha sonra tekrar deneyin.</p>
    </section>
}
else if (_menu is not null)
{
    var themeClass = PublicMenuThemeStyleBuilder.GetThemePresetClass(_menu.Theme.ThemePreset);
    var fontClass = PublicMenuThemeStyleBuilder.GetFontPresetClass(_menu.Theme.FontPreset);
    var searchQuery = NormalizeSearchQuery(SearchQuery);
    var isSearching = !string.IsNullOrWhiteSpace(searchQuery);
    var searchResults = isSearching ? GetSearchResults(searchQuery).ToArray() : [];

    <div class="public-menu @themeClass @fontClass" style="@PublicMenuThemeStyleBuilder.BuildStyle(_menu.Theme)">
        <header class="menu-hero">
            @if (!string.IsNullOrWhiteSpace(_menu.CoverImageUrl))
            {
                <img class="cover-image" src="@_menu.CoverImageUrl" alt="" loading="eager" />
            }
            <div class="hero-content">
                @if (!string.IsNullOrWhiteSpace(_menu.LogoImageUrl))
                {
                    <img class="logo-image" src="@_menu.LogoImageUrl" alt="@($"{_menu.CafeName} logo")" />
                }
                <div>
                    <p class="menu-label">Menü</p>
                    <h1>@_menu.CafeName</h1>
                    @if (!string.IsNullOrWhiteSpace(_menu.Theme.WelcomeTitle))
                    {
                        <h2>@_menu.Theme.WelcomeTitle</h2>
                    }
                    @if (!string.IsNullOrWhiteSpace(_menu.Theme.WelcomeDescription))
                    {
                        <p class="welcome-description">@_menu.Theme.WelcomeDescription</p>
                    }
                </div>
            </div>
        </header>

        <section class="menu-search" aria-label="Ürün arama">
            <form method="get" action="@($"/c/{Uri.EscapeDataString(_menu.Slug)}")">
                <label for="public-menu-search">Menüde ara</label>
                <div class="search-control">
                    <input id="public-menu-search"
                           name="q"
                           type="search"
                           value="@searchQuery"
                           maxlength="80"
                           autocomplete="off"
                           placeholder="Ürün adı veya açıklama" />
                    <button type="submit">Ara</button>
                    @if (isSearching)
                    {
                        <a href="@($"/c/{Uri.EscapeDataString(_menu.Slug)}")">Temizle</a>
                    }
                </div>
            </form>
        </section>

        @if (_menu.Categories.Count == 0)
        {
            <section class="empty-menu">
                <h2>Menü hazırlanıyor</h2>
                <p>Şu anda yayında olan kategori veya ürün bulunmuyor.</p>
            </section>
        }
        else if (isSearching)
        {
            <section class="search-results" aria-live="polite">
                <div class="search-heading">
                    <h2>Arama sonuçları</h2>
                    <p>@($"\"{searchQuery}\" için {searchResults.Length} sonuç")</p>
                </div>

                @if (searchResults.Length == 0)
                {
                    <div class="empty-search" data-state="no-search-results">
                        <h3>Sonuç bulunamadı</h3>
                        <p>Farklı bir ürün adı veya açıklama ile tekrar arayın.</p>
                    </div>
                }
                else
                {
                    <div class="product-list">
                        @foreach (var result in searchResults)
                        {
                            <PublicMenuProductCard Product="result.Product"
                                                   Slug="@_menu.Slug"
                                                   CategoryName="@result.CategoryName"
                                                   ShowCategoryName="true" />
                        }
                    </div>
                }
            </section>
        }
        else
        {
            <nav class="category-nav" aria-label="Kategoriler">
                @foreach (var category in _menu.Categories)
                {
                    <a href="@($"#category-{category.Id}")">@category.Name</a>
                }
            </nav>

            <div class="category-list">
                @foreach (var category in _menu.Categories)
                {
                    <section class="category-section" id="@($"category-{category.Id}")">
                        <div class="category-heading">
                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img src="@category.ImageUrl" alt="" loading="lazy" />
                            }
                            <div>
                                <h2>@category.Name</h2>
                                @if (!string.IsNullOrWhiteSpace(category.Description))
                                {
                                    <p>@category.Description</p>
                                }
                            </div>
                        </div>

                        @if (category.Products.Count == 0)
                        {
                            <p class="empty-category">Bu kategoride yayında olan ürün bulunmuyor.</p>
                        }
                        else
                        {
                            <div class="product-list">
                                @foreach (var product in category.Products)
                                {
                                    <PublicMenuProductCard Product="product" Slug="@_menu.Slug" />
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
    </div>
}

@code {
    private PublicMenuPageStatus _status = PublicMenuPageStatus.Loading;
    private PublicMenuResponse? _menu;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _status = PublicMenuPageStatus.Loading;
        _menu = null;

        var result = await PublicMenuApiClient.GetMenuAsync(Slug, CancellationToken.None);

        if (result.Status == PublicMenuRequestStatus.Success && result.Menu is not null)
        {
            _menu = result.Menu;
            _status = PublicMenuPageStatus.Success;
            return;
        }

        _status = result.Status == PublicMenuRequestStatus.NotFound
            ? PublicMenuPageStatus.NotFound
            : PublicMenuPageStatus.Failure;
    }

    private IEnumerable<ProductSearchResult> GetSearchResults(string query)
    {
        if (_menu is null)
        {
            return [];
        }

        return _menu.Categories
            .SelectMany(category => category.Products
                .Where(product => ProductMatchesSearch(product, query))
                .Select(product => new ProductSearchResult(category.Name, product)))
            .OrderBy(result => result.Product.DisplayOrder)
            .ThenBy(result => result.Product.Name);
    }

    private static bool ProductMatchesSearch(PublicMenuProductResponse product, string query)
    {
        return product.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrWhiteSpace(product.Description) &&
                product.Description.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private static string NormalizeSearchQuery(string? query)
    {
        return string.IsNullOrWhiteSpace(query) ? string.Empty : query.Trim();
    }

    private enum PublicMenuPageStatus
    {
        Loading,
        Success,
        NotFound,
        Failure
    }

    private sealed record ProductSearchResult(string CategoryName, PublicMenuProductResponse Product);
}
