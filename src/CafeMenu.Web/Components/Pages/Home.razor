@page "/"

<PageTitle>CafeMenu</PageTitle>

<section class="simple-page">
    <p class="simple-kicker">CafeMenu</p>
    <h1>QR menü yönetimi</h1>

    <AuthorizeView>
        <Authorized>
            <p>Yönetim panelinden cafelerinizi yönetin veya müşteri menüsünü görüntüleyin.</p>
        </Authorized>
        <NotAuthorized>
            <p>Cafe yönetimi için giriş yapın veya müşteri menüsü bağlantısını açın.</p>
        </NotAuthorized>
    </AuthorizeView>
    <div class="simple-actions">
        <a href="/admin">Yönetim paneli</a>
        <AuthorizeView>
            <NotAuthorized>
                <a href="/account/login">Giriş</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>
