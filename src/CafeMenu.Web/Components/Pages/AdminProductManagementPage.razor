@page "/admin/cafes/{CafeId:long}/products"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@inject IAdminCafeApiClient AdminCafeApiClient
@inject IAdminCategoryApiClient AdminCategoryApiClient
@inject IAdminProductApiClient AdminProductApiClient

<PageTitle>Ürünler</PageTitle>

<section class="admin-page admin-product-page">
    @if (_isLoading)
    {
        <section class="admin-state" aria-live="polite">
            <h1>Yükleniyor</h1>
            <p>Ürün yönetimi hazırlanıyor.</p>
        </section>
    }
    else if (_accessLoadFailed)
    {
        <section class="admin-state admin-state-warning" role="alert">
            <h1>Cafe erişimi doğrulanamadı</h1>
            <p>Şu anda cafe erişimi kontrol edilemiyor. Lütfen daha sonra tekrar deneyin.</p>
        </section>
    }
    else if (_cafe is null)
    {
        <section class="admin-state admin-state-denied" role="alert">
            <h1>Erişim yok</h1>
            <p>Bu cafe hesabınız için erişilebilir değil veya artık yönetilebilir durumda değil.</p>
        </section>
    }
    else
    {
        <AdminCafeHeader
            Cafe="_cafe"
            ActiveSection="AdminCafeSection.Products"
            Kicker="Ürün Yönetimi"
            Summary="Ürünleri oluşturun, düzenleyin, görünürlük ve stok durumunu yönetin." />

        @if (!string.IsNullOrWhiteSpace(_pageMessage))
        {
            <section class="@_pageMessageCssClass" role="status">@_pageMessage</section>
        }

        <EditForm Model="_productActionModel" OnSubmit="HandleProductActionAsync" FormName="ProductActionForm" id="ProductActionForm" method="post" class="admin-action-form"></EditForm>

        @if (_categoryLoadFailed)
        {
            <section class="admin-state admin-state-warning" role="alert">
                <h2>Kategoriler yüklenemedi</h2>
                <p>Ürün formu için kategori listesi alınamadı. Lütfen daha sonra tekrar deneyin.</p>
            </section>
        }
        else if (_categories.Count == 0)
        {
            <section class="admin-panel">
                <h2>Önce kategori oluşturun</h2>
                <p class="admin-page-summary">Ürünler bir kategoriye bağlı olmalıdır. Bu cafe için henüz kategori yok.</p>
                <a class="admin-primary-button" href="@($"/admin/cafes/{_cafe.Id}/categories")">Kategori oluştur</a>
            </section>
        }
        else
        {
            <section class="admin-panel">
                <h2>Yeni ürün</h2>
                <EditForm Model="_createModel" OnValidSubmit="CreateProductAsync" FormName="CreateProductForm" method="post">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="admin-form-grid">
                        <label>
                            Ad
                            <InputText @bind-Value="_createModel.Name" maxlength="180" />
                        </label>
                        <label>
                            Kategori
                            <InputSelect @bind-Value="_createModel.CategoryId">
                                <option value="0">Kategori seçin</option>
                                @foreach (var category in _categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                        </label>
                        <label>
                            Fiyat (TL)
                            <InputNumber @bind-Value="_createModel.Price" step="0.01" />
                        </label>
                        <label>
                            Sıralama
                            <InputNumber @bind-Value="_createModel.DisplayOrder" />
                        </label>
                        <label class="admin-form-wide">
                            Açıklama
                            <InputTextArea @bind-Value="_createModel.Description" maxlength="2000" />
                        </label>
                        <label class="admin-form-wide">
                            Görsel URL
                            <InputText @bind-Value="_createModel.ImageUrl" maxlength="500" />
                        </label>
                        <label class="admin-check">
                            <InputCheckbox @bind-Value="_createModel.IsVisible" />
                            Görünür
                        </label>
                        <label class="admin-check">
                            <InputCheckbox @bind-Value="_createModel.IsAvailable" />
                            Mevcut
                        </label>
                    </div>

                    <button class="admin-primary-button" type="submit" disabled="@_isMutating">Ürün oluştur</button>
                </EditForm>
            </section>
        }

        <section class="admin-panel">
            <div class="admin-list-header">
                <h2>Ürünler</h2>
                <a class="admin-secondary-button" href="@CurrentProductRoute">Yenile</a>
            </div>

            @if (_productLoadFailed)
            {
                <section class="admin-state admin-state-warning" role="alert">
                    <h3>Ürünler yüklenemedi</h3>
                    <p>Şu anda ürün listesi alınamıyor.</p>
                </section>
            }
            else if (_products.Count == 0)
            {
                <section class="admin-state">
                    <h3>Henüz ürün yok</h3>
                    <p>Bu cafe için ilk ürünü oluşturabilirsiniz.</p>
                </section>
            }
            else
            {
                <div class="admin-product-groups">
                    @foreach (var group in GetProductGroups())
                    {
                        <section class="admin-product-group">
                            <h3>@GetCategoryName(group.Key)</h3>

                            <div class="admin-product-list">
                                @foreach (var product in group)
                                {
                                    <article class="admin-product-item">
                                        @if (_editingProductId == product.Id)
                                        {
                                            <EditForm Model="_editModel" OnValidSubmit="UpdateProductAsync" FormName="UpdateProductForm" method="post">
                                                <DataAnnotationsValidator />
                                                <ValidationSummary />
                                                <input type="hidden" name="_editModel.ProductId" value="@_editModel.ProductId" />

                                                <div class="admin-form-grid">
                                                    <label>
                                                        Ad
                                                        <InputText @bind-Value="_editModel.Name" maxlength="180" />
                                                    </label>
                                                    <label>
                                                        Kategori
                                                        <InputSelect @bind-Value="_editModel.CategoryId">
                                                            @foreach (var category in _categories)
                                                            {
                                                                <option value="@category.Id">@category.Name</option>
                                                            }
                                                        </InputSelect>
                                                    </label>
                                                    <label>
                                                        Fiyat (TL)
                                                        <InputNumber @bind-Value="_editModel.Price" step="0.01" />
                                                    </label>
                                                    <label>
                                                        Sıralama
                                                        <InputNumber @bind-Value="_editModel.DisplayOrder" />
                                                    </label>
                                                    <label class="admin-form-wide">
                                                        Açıklama
                                                        <InputTextArea @bind-Value="_editModel.Description" maxlength="2000" />
                                                    </label>
                                                    <label class="admin-form-wide">
                                                        Görsel URL
                                                        <InputText @bind-Value="_editModel.ImageUrl" maxlength="500" />
                                                    </label>
                                                </div>

                                                <div class="admin-actions">
                                                    <button class="admin-primary-button" type="submit" disabled="@_isMutating">Kaydet</button>
                                                    <button class="admin-secondary-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildProductAction("CancelEdit", product.Id)" disabled="@_isMutating">Vazgeç</button>
                                                </div>
                                            </EditForm>
                                        }
                                        else
                                        {
                                            <div class="admin-product-content">
                                                <div>
                                                    <h4>@product.Name</h4>
                                                    @if (!string.IsNullOrWhiteSpace(product.Description))
                                                    {
                                                        <p>@product.Description</p>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                                    {
                                                        <a class="admin-image-reference" href="@product.ImageUrl" target="_blank" rel="noopener noreferrer">Görsel referansı</a>
                                                    }
                                                </div>
                                                <div class="admin-product-price">@FormatPrice(product.Price)</div>
                                            </div>

                                            <div class="admin-product-meta">
                                                <span class="admin-badge admin-badge-muted">Sıra @product.DisplayOrder</span>
                                                <span class="admin-badge admin-badge-muted">@GetCategoryName(product.CategoryId)</span>
                                                <span class="@GetVisibleBadgeClass(product.IsVisible)">@GetVisibleLabel(product.IsVisible)</span>
                                                <span class="@GetAvailableBadgeClass(product.IsAvailable)">@GetAvailableLabel(product.IsAvailable)</span>
                                                <span class="@GetPublishedBadgeClass(product.IsPublished)">@GetPublishedLabel(product.IsPublished)</span>
                                            </div>

                                            @if (_pendingDeleteProductId == product.Id)
                                            {
                                                <div class="admin-confirm" role="alert">
                                                    <p>@product.Name ürünü soft-delete ile silinecek. Onaylıyor musunuz?</p>
                                                    <div class="admin-actions">
                                                        <button class="admin-danger-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildProductAction("Delete", product.Id)" disabled="@_isMutating">Sil</button>
                                                        <button class="admin-secondary-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildProductAction("CancelDelete", product.Id)" disabled="@_isMutating">Vazgeç</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="admin-actions">
                                                    <button class="admin-secondary-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildProductAction("Edit", product.Id)" disabled="@_isMutating">Düzenle</button>
                                                    <button class="admin-secondary-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildVisibilityAction(product)" disabled="@_isMutating">@GetVisibilityActionLabel(product.IsVisible)</button>
                                                    <button class="admin-secondary-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildAvailabilityAction(product)" disabled="@_isMutating">@GetAvailabilityActionLabel(product.IsAvailable)</button>
                                                    <button class="admin-secondary-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildMoveAction(product, -1)" disabled="@IsMoveUpDisabled(product)">Yukarı</button>
                                                    <button class="admin-secondary-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildMoveAction(product, 1)" disabled="@IsMoveDownDisabled(product)">Aşağı</button>
                                                    <button class="admin-danger-button" type="submit" form="ProductActionForm" name="_productActionModel.Action" value="@BuildProductAction("ConfirmDelete", product.Id)" disabled="@_isMutating">Sil</button>
                                                </div>
                                            }
                                        }
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    private static readonly CultureInfo TurkishCulture = CultureInfo.GetCultureInfo("tr-TR");

    [Parameter]
    public long CafeId { get; set; }

    private bool _isLoading = true;
    private bool _isMutating;
    private bool _accessLoadFailed;
    private bool _categoryLoadFailed;
    private bool _productLoadFailed;
    private string? _pageMessage;
    private string _pageMessageCssClass = "admin-message";
    private AdminCafeResponse? _cafe;
    private IReadOnlyList<AdminCategoryResponse> _categories = [];
    private IReadOnlyList<AdminProductResponse> _products = [];
    private AdminProductFormModel _createModel = new();
    private AdminProductFormModel _editModel = new();
    private AdminProductActionFormModel _productActionModel = new();
    private long? _editingProductId;
    private long? _pendingDeleteProductId;

    [SupplyParameterFromForm(FormName = "CreateProductForm", Name = "_createModel")]
    private AdminProductFormModel? CreateFormModel { get; set; }

    [SupplyParameterFromForm(FormName = "UpdateProductForm", Name = "_editModel")]
    private AdminProductFormModel? UpdateFormModel { get; set; }

    [SupplyParameterFromForm(FormName = "ProductActionForm", Name = "_productActionModel")]
    private AdminProductActionFormModel? ProductActionFormModel { get; set; }

    private string CurrentProductRoute => $"/admin/cafes/{CafeId}/products";

    protected override async Task OnParametersSetAsync()
    {
        ResetPageState();
        _createModel = CreateFormModel ?? new AdminProductFormModel();
        _editModel = UpdateFormModel ?? new AdminProductFormModel();
        _productActionModel = ProductActionFormModel ?? new AdminProductActionFormModel();

        if (_editModel.ProductId > 0)
        {
            _editingProductId = _editModel.ProductId;
        }

        var cafeResult = await AdminCafeApiClient.GetMyCafesAsync(CancellationToken.None);
        if (cafeResult.Status == AdminCafeListStatus.Failure)
        {
            _accessLoadFailed = true;
            _isLoading = false;
            return;
        }

        _cafe = cafeResult.Cafes.SingleOrDefault(cafe => cafe.Id == CafeId);
        if (_cafe is null)
        {
            _isLoading = false;
            return;
        }

        await LoadCategoriesAsync();
        await LoadProductsAsync();
        _isLoading = false;
    }

    private async Task LoadCategoriesAsync()
    {
        if (_cafe is null)
        {
            return;
        }

        _categoryLoadFailed = false;
        var result = await AdminCategoryApiClient.GetCategoriesAsync(_cafe.Id, CancellationToken.None);
        if (result.Status == AdminCategoryRequestStatus.Success)
        {
            _categories = result.Categories
                .OrderBy(category => category.DisplayOrder)
                .ThenBy(category => category.Name, StringComparer.Ordinal)
                .ThenBy(category => category.Id)
                .ToArray();
            return;
        }

        _categories = [];
        _categoryLoadFailed = true;
    }

    private async Task LoadProductsAsync()
    {
        if (_cafe is null)
        {
            return;
        }

        _productLoadFailed = false;
        var result = await AdminProductApiClient.GetProductsAsync(_cafe.Id, CancellationToken.None);
        if (result.Status == AdminProductRequestStatus.Success)
        {
            _products = SortProducts(result.Products);
            return;
        }

        _products = [];
        _productLoadFailed = true;
    }

    private async Task CreateProductAsync()
    {
        if (_cafe is null || _categories.Count == 0)
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            var result = await AdminProductApiClient.CreateProductAsync(
                new AdminCreateProductRequest(
                    _cafe.Id,
                    _createModel.CategoryId,
                    _createModel.Name,
                    NormalizeOptionalText(_createModel.Description),
                    _createModel.Price,
                    NormalizeOptionalText(_createModel.ImageUrl),
                    _createModel.IsAvailable,
                    _createModel.IsVisible,
                    _createModel.DisplayOrder),
                CancellationToken.None);

            if (result.Status == AdminProductRequestStatus.Success)
            {
                _createModel = new AdminProductFormModel();
                await LoadProductsAsync();
                SetSuccessMessage("Ürün oluşturuldu.");
                return;
            }

            SetMutationFailureMessage(result.Status, "Ürün oluşturulamadı.");
        });
    }

    private void BeginEdit(AdminProductResponse product)
    {
        _editingProductId = product.Id;
        _pendingDeleteProductId = null;
        _editModel = AdminProductFormModel.FromProduct(product);
        ClearMessage();
    }

    private void CancelEdit()
    {
        _editingProductId = null;
        _editModel = new AdminProductFormModel();
    }

    private async Task UpdateProductAsync()
    {
        if (_cafe is null || _editModel.ProductId <= 0)
        {
            return;
        }

        var productId = _editModel.ProductId;
        await RunMutationAsync(async () =>
        {
            var result = await AdminProductApiClient.UpdateProductAsync(
                productId,
                new AdminUpdateProductRequest(
                    _cafe.Id,
                    _editModel.CategoryId,
                    _editModel.Name,
                    NormalizeOptionalText(_editModel.Description),
                    _editModel.Price,
                    NormalizeOptionalText(_editModel.ImageUrl),
                    _editModel.DisplayOrder),
                CancellationToken.None);

            if (result.Status == AdminProductRequestStatus.Success)
            {
                _editingProductId = null;
                _editModel = new AdminProductFormModel();
                await LoadProductsAsync();
                SetSuccessMessage("Ürün güncellendi.");
                return;
            }

            SetMutationFailureMessage(result.Status, "Ürün güncellenemedi.");
        });
    }

    private async Task HandleProductActionAsync(EditContext editContext)
    {
        if (_cafe is null || string.IsNullOrWhiteSpace(_productActionModel.Action))
        {
            return;
        }

        var parts = _productActionModel.Action.Split('|', StringSplitOptions.TrimEntries);
        if (parts.Length < 2 || !long.TryParse(parts[1], out var productId))
        {
            return;
        }

        var product = _products.SingleOrDefault(item => item.Id == productId);
        if (product is null)
        {
            return;
        }

        switch (parts[0])
        {
            case "Edit":
                BeginEdit(product);
                break;
            case "CancelEdit":
                CancelEdit();
                break;
            case "ConfirmDelete":
                ConfirmDelete(product.Id);
                break;
            case "CancelDelete":
                CancelDelete();
                break;
            case "Delete":
                await DeleteProductAsync(product.Id);
                break;
            case "Visibility" when parts.Length == 3 && bool.TryParse(parts[2], out var isVisible):
                await ChangeVisibilityAsync(product, isVisible);
                break;
            case "Availability" when parts.Length == 3 && bool.TryParse(parts[2], out var isAvailable):
                await ChangeAvailabilityAsync(product, isAvailable);
                break;
            case "Move" when parts.Length == 3 && int.TryParse(parts[2], out var direction):
                await MoveProductAsync(product, direction);
                break;
        }
    }

    private async Task ChangeVisibilityAsync(AdminProductResponse product, bool isVisible)
    {
        if (_cafe is null)
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            var result = await AdminProductApiClient.ChangeProductVisibilityAsync(
                product.Id,
                new AdminChangeProductVisibilityRequest(_cafe.Id, isVisible),
                CancellationToken.None);

            if (result.Status == AdminProductRequestStatus.Success)
            {
                await LoadProductsAsync();
                SetSuccessMessage("Ürün görünürlüğü güncellendi.");
                return;
            }

            SetMutationFailureMessage(result.Status, "Ürün görünürlüğü güncellenemedi.");
        });
    }

    private async Task ChangeAvailabilityAsync(AdminProductResponse product, bool isAvailable)
    {
        if (_cafe is null)
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            var result = await AdminProductApiClient.ChangeProductAvailabilityAsync(
                product.Id,
                new AdminChangeProductAvailabilityRequest(_cafe.Id, isAvailable),
                CancellationToken.None);

            if (result.Status == AdminProductRequestStatus.Success)
            {
                await LoadProductsAsync();
                SetSuccessMessage("Ürün stok durumu güncellendi.");
                return;
            }

            SetMutationFailureMessage(result.Status, "Ürün stok durumu güncellenemedi.");
        });
    }

    private void ConfirmDelete(long productId)
    {
        _pendingDeleteProductId = productId;
        _editingProductId = null;
        ClearMessage();
    }

    private void CancelDelete()
    {
        _pendingDeleteProductId = null;
    }

    private async Task DeleteProductAsync(long productId)
    {
        await RunMutationAsync(async () =>
        {
            var result = await AdminProductApiClient.DeleteProductAsync(productId, CancellationToken.None);

            if (result.Status == AdminProductRequestStatus.Success)
            {
                _pendingDeleteProductId = null;
                await LoadProductsAsync();
                SetSuccessMessage("Ürün silindi.");
                return;
            }

            SetErrorMessage("Ürün silinemedi.");
        });
    }

    private async Task MoveProductAsync(AdminProductResponse product, int direction)
    {
        if (_cafe is null)
        {
            return;
        }

        var items = GetProductsForCategory(product.CategoryId).ToList();
        var currentIndex = items.FindIndex(item => item.Id == product.Id);
        var targetIndex = currentIndex + direction;

        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= items.Count)
        {
            return;
        }

        (items[currentIndex], items[targetIndex]) = (items[targetIndex], items[currentIndex]);
        var request = new AdminReorderProductsRequest(
            _cafe.Id,
            product.CategoryId,
            items
                .Select((item, index) => new AdminProductOrderRequest(item.Id, index))
                .ToArray());

        await RunMutationAsync(async () =>
        {
            var result = await AdminProductApiClient.ReorderProductsAsync(request, CancellationToken.None);

            if (result.Status == AdminProductRequestStatus.Success)
            {
                await LoadProductsAsync();
                SetSuccessMessage("Ürün sıralaması güncellendi.");
                return;
            }

            SetErrorMessage("Ürün sıralaması güncellenemedi.");
        });
    }

    private bool IsMoveUpDisabled(AdminProductResponse product)
    {
        var items = GetProductsForCategory(product.CategoryId);
        return _isMutating || items.Count == 0 || items[0].Id == product.Id;
    }

    private bool IsMoveDownDisabled(AdminProductResponse product)
    {
        var items = GetProductsForCategory(product.CategoryId);
        return _isMutating || items.Count == 0 || items[^1].Id == product.Id;
    }

    private async Task RunMutationAsync(Func<Task> operation)
    {
        _isMutating = true;
        ClearMessage();

        try
        {
            await operation();
        }
        finally
        {
            _isMutating = false;
        }
    }

    private void ResetPageState()
    {
        _isLoading = true;
        _isMutating = false;
        _accessLoadFailed = false;
        _categoryLoadFailed = false;
        _productLoadFailed = false;
        _cafe = null;
        _categories = [];
        _products = [];
        ClearMessage();
    }

    private void SetMutationFailureMessage(AdminProductRequestStatus status, string fallbackMessage)
    {
        if (status == AdminProductRequestStatus.ValidationError)
        {
            SetErrorMessage("Form alanlarını kontrol edin. Backend doğrulaması isteği reddetti.");
            return;
        }

        SetErrorMessage(fallbackMessage);
    }

    private void SetSuccessMessage(string message)
    {
        _pageMessage = message;
        _pageMessageCssClass = "admin-message admin-message-success";
    }

    private void SetErrorMessage(string message)
    {
        _pageMessage = message;
        _pageMessageCssClass = "admin-message admin-message-error";
    }

    private void ClearMessage()
    {
        _pageMessage = null;
        _pageMessageCssClass = "admin-message";
    }

    private IEnumerable<IGrouping<long, AdminProductResponse>> GetProductGroups()
    {
        return _products
            .GroupBy(product => product.CategoryId)
            .OrderBy(group => GetCategoryDisplayOrder(group.Key))
            .ThenBy(group => GetCategoryName(group.Key), StringComparer.Ordinal)
            .ThenBy(group => group.Key);
    }

    private IReadOnlyList<AdminProductResponse> GetProductsForCategory(long categoryId)
    {
        return _products
            .Where(product => product.CategoryId == categoryId)
            .OrderBy(product => product.DisplayOrder)
            .ThenBy(product => product.Name, StringComparer.Ordinal)
            .ThenBy(product => product.Id)
            .ToArray();
    }

    private IReadOnlyList<AdminProductResponse> SortProducts(IReadOnlyCollection<AdminProductResponse> products)
    {
        return products
            .OrderBy(product => GetCategoryDisplayOrder(product.CategoryId))
            .ThenBy(product => GetCategoryName(product.CategoryId), StringComparer.Ordinal)
            .ThenBy(product => product.CategoryId)
            .ThenBy(product => product.DisplayOrder)
            .ThenBy(product => product.Name, StringComparer.Ordinal)
            .ThenBy(product => product.Id)
            .ToArray();
    }

    private int GetCategoryDisplayOrder(long categoryId)
    {
        return _categories.FirstOrDefault(category => category.Id == categoryId)?.DisplayOrder ?? int.MaxValue;
    }

    private string GetCategoryName(long categoryId)
    {
        return _categories.FirstOrDefault(category => category.Id == categoryId)?.Name ?? $"Kategori #{categoryId}";
    }

    private static string? NormalizeOptionalText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static string BuildProductAction(string action, long productId)
    {
        return $"{action}|{productId}";
    }

    private static string BuildVisibilityAction(AdminProductResponse product)
    {
        return $"Visibility|{product.Id}|{!product.IsVisible}";
    }

    private static string BuildAvailabilityAction(AdminProductResponse product)
    {
        return $"Availability|{product.Id}|{!product.IsAvailable}";
    }

    private static string BuildMoveAction(AdminProductResponse product, int direction)
    {
        return $"Move|{product.Id}|{direction}";
    }

    private static string FormatPrice(decimal price)
    {
        return string.Create(TurkishCulture, $"{price:N2} ₺");
    }

    private static string GetPublishedLabel(bool isPublished)
    {
        return isPublished ? "Yayında" : "Taslak";
    }

    private static string GetVisibleLabel(bool isVisible)
    {
        return isVisible ? "Görünür" : "Gizli";
    }

    private static string GetAvailableLabel(bool isAvailable)
    {
        return isAvailable ? "Mevcut" : "Tükendi";
    }

    private static string GetVisibilityActionLabel(bool isVisible)
    {
        return isVisible ? "Gizle" : "Görünür yap";
    }

    private static string GetAvailabilityActionLabel(bool isAvailable)
    {
        return isAvailable ? "Tükendi yap" : "Mevcut yap";
    }

    private static string GetPublishedBadgeClass(bool isPublished)
    {
        return isPublished
            ? "admin-badge admin-badge-info"
            : "admin-badge admin-badge-muted";
    }

    private static string GetVisibleBadgeClass(bool isVisible)
    {
        return isVisible
            ? "admin-badge admin-badge-success"
            : "admin-badge admin-badge-muted";
    }

    private static string GetAvailableBadgeClass(bool isAvailable)
    {
        return isAvailable
            ? "admin-badge admin-badge-success"
            : "admin-badge admin-badge-warning";
    }
}
