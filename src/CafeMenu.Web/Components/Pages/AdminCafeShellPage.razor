@page "/admin/cafes/{CafeId:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IAdminCafeApiClient AdminCafeApiClient

<PageTitle>Cafe Admin</PageTitle>

<section class="admin-page admin-cafe-shell">
    @if (_isLoading)
    {
        <section class="admin-state" aria-live="polite">
            <h1>Yükleniyor</h1>
            <p>Cafe erişiminiz doğrulanıyor.</p>
        </section>
    }
    else if (_status == AdminCafeListStatus.Failure)
    {
        <section class="admin-state admin-state-warning" role="alert">
            <h1>Cafe bilgisi yüklenemedi</h1>
            <p>Şu anda cafe erişimi doğrulanamıyor. Lütfen daha sonra tekrar deneyin.</p>
        </section>
    }
    else if (_cafe is null)
    {
        <section class="admin-state admin-state-denied" role="alert">
            <h1>Erişim yok</h1>
            <p>Bu cafe hesabınız için erişilebilir değil veya artık yönetilebilir durumda değil.</p>
        </section>
    }
    else
    {
        <AdminCafeHeader
            Cafe="_cafe"
            ActiveSection="AdminCafeSection.Overview"
            Kicker="Cafe Dashboard"
            Summary="Bu cafe için durum özetini takip edin ve yönetim alanlarına geçin." />

        <section class="admin-dashboard-status" aria-label="Cafe durum özeti">
            <span class="@GetActiveBadgeClass(_cafe.IsActive)">@GetActiveLabel(_cafe.IsActive)</span>
            <span class="@GetPublishedBadgeClass(_cafe.IsPublished)">@GetPublishedLabel(_cafe.IsPublished)</span>
        </section>

        @if (_statsStatus == AdminCafeListStatus.Failure)
        {
            <section class="admin-state admin-state-warning" role="alert">
                <h2>Dashboard özeti yüklenemedi</h2>
                <p>Yönetim bağlantıları kullanılabilir, ancak sayısal özetler şu anda alınamıyor.</p>
            </section>
        }
        else if (_stats is not null)
        {
            <section class="admin-dashboard-grid" aria-label="Cafe dashboard istatistikleri">
                <article class="admin-stat-card">
                    <span class="admin-stat-label">Toplam kategori</span>
                    <strong>@_stats.TotalCategoryCount</strong>
                </article>
                <article class="admin-stat-card">
                    <span class="admin-stat-label">Yayında / görünür kategori</span>
                    <strong>@_stats.PublicCategoryCount</strong>
                </article>
                <article class="admin-stat-card">
                    <span class="admin-stat-label">Toplam ürün</span>
                    <strong>@_stats.TotalProductCount</strong>
                </article>
                <article class="admin-stat-card">
                    <span class="admin-stat-label">Yayında / görünür ürün</span>
                    <strong>@_stats.PublicProductCount</strong>
                </article>
                <article class="admin-stat-card">
                    <span class="admin-stat-label">Mevcut ürün</span>
                    <strong>@_stats.AvailableProductCount</strong>
                </article>
                <article class="admin-stat-card">
                    <span class="admin-stat-label">Tükendi</span>
                    <strong>@_stats.UnavailableProductCount</strong>
                </article>
            </section>
        }

        <section class="admin-shell-grid" aria-label="Cafe yönetim girişleri">
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/settings")">
                <span>Cafe Ayarları</span>
                <p>Ad ve slug gibi backend tarafından desteklenen temel bilgileri yönetin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/categories")">
                <span>Kategoriler</span>
                <p>Menü kategorilerini oluşturun, düzenleyin, görünürlüğünü değiştirin ve sıralayın.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/products")">
                <span>Ürünler</span>
                <p>Ürünleri, fiyatları, görünürlüğü ve stok durumunu yönetin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/branding")">
                <span>Görünüm</span>
                <p>Logo, kapak referansı, tema, renkler ve karşılama metinlerini düzenleyin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/qr")">
                <span>QR Kod</span>
                <p>Public menü adresini QR olarak önizleyin ve baskı için indirin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/c/{_cafe.Slug}")" target="_blank" rel="noopener noreferrer">
                <span>Public Menü</span>
                <p>Yayınlanan müşteri menüsünü mevcut slug ile açın.</p>
            </a>
        </section>

        <section class="admin-shell-panel">
            <p>Bu özet soft-delete edilmiş kayıtları saymaz. Yayında / görünür değerleri public menüye çıkabilecek kategori ve ürünleri gösterir.</p>
            <p class="admin-security-note">Bu ekran route bilgisini yalnız seçim bağlamı olarak kullanır. Gerçek yetkilendirme her backend API çağrısında tekrar yapılacaktır.</p>
        </section>
    }
</section>

@code {
    [Parameter]
    public long CafeId { get; set; }

    private bool _isLoading = true;
    private AdminCafeListStatus _status;
    private AdminCafeListStatus _statsStatus;
    private AdminCafeResponse? _cafe;
    private AdminCafeDashboardStatsResponse? _stats;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _cafe = null;
        _stats = null;
        _statsStatus = AdminCafeListStatus.Success;

        var result = await AdminCafeApiClient.GetMyCafesAsync(CancellationToken.None);
        _status = result.Status;
        _cafe = result.Status == AdminCafeListStatus.Success
            ? result.Cafes.SingleOrDefault(cafe => cafe.Id == CafeId)
            : null;

        if (_cafe is not null)
        {
            var statsResult = await AdminCafeApiClient.GetCafeDashboardStatsAsync(_cafe.Id, CancellationToken.None);
            _statsStatus = statsResult.Status;
            _stats = statsResult.Stats;
        }

        _isLoading = false;
    }

    private static string GetActiveLabel(bool isActive)
    {
        return isActive ? "Aktif" : "Pasif";
    }

    private static string GetPublishedLabel(bool isPublished)
    {
        return isPublished ? "Yayında" : "Taslak";
    }

    private static string GetActiveBadgeClass(bool isActive)
    {
        return isActive
            ? "admin-status-badge admin-status-badge-success"
            : "admin-status-badge admin-status-badge-muted";
    }

    private static string GetPublishedBadgeClass(bool isPublished)
    {
        return isPublished
            ? "admin-status-badge admin-status-badge-info"
            : "admin-status-badge admin-status-badge-muted";
    }

}
