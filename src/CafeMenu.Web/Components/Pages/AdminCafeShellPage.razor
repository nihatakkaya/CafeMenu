@page "/admin/cafes/{CafeId:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IAdminCafeApiClient AdminCafeApiClient

<PageTitle>Cafe Admin</PageTitle>

<section class="admin-page admin-cafe-shell">
    @if (_isLoading)
    {
        <section class="admin-state" aria-live="polite">
            <h1>Yükleniyor</h1>
            <p>Cafe erişiminiz doğrulanıyor.</p>
        </section>
    }
    else if (_status == AdminCafeListStatus.Failure)
    {
        <section class="admin-state admin-state-warning" role="alert">
            <h1>Cafe bilgisi yüklenemedi</h1>
            <p>Şu anda cafe erişimi doğrulanamıyor. Lütfen daha sonra tekrar deneyin.</p>
        </section>
    }
    else if (_cafe is null)
    {
        <section class="admin-state admin-state-denied" role="alert">
            <h1>Erişim yok</h1>
            <p>Bu cafe hesabınız için erişilebilir değil veya artık yönetilebilir durumda değil.</p>
        </section>
    }
    else
    {
        <AdminCafeHeader
            Cafe="_cafe"
            ActiveSection="AdminCafeSection.Overview"
            Kicker="Cafe Yönetimi"
            Summary="Bu cafe için mevcut yönetim alanlarına buradan geçebilirsiniz." />

        <section class="admin-shell-grid" aria-label="Cafe yönetim girişleri">
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/settings")">
                <span>Cafe Ayarları</span>
                <p>Ad ve slug gibi backend tarafından desteklenen temel bilgileri yönetin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/categories")">
                <span>Kategoriler</span>
                <p>Menü kategorilerini oluşturun, düzenleyin, görünürlüğünü değiştirin ve sıralayın.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/products")">
                <span>Ürünler</span>
                <p>Ürünleri, fiyatları, görünürlüğü ve stok durumunu yönetin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/branding")">
                <span>Görünüm</span>
                <p>Logo, kapak referansı, tema, renkler ve karşılama metinlerini düzenleyin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/admin/cafes/{_cafe.Id}/qr")">
                <span>QR Kod</span>
                <p>Public menü adresini QR olarak önizleyin ve baskı için indirin.</p>
            </a>
            <a class="admin-shell-card" href="@($"/c/{_cafe.Slug}")" target="_blank" rel="noopener noreferrer">
                <span>Public Menü</span>
                <p>Yayınlanan müşteri menüsünü mevcut slug ile açın.</p>
            </a>
        </section>

        <section class="admin-shell-panel">
            <p>Dashboard analytics sonraki fazlarda eklenecek.</p>
            <p class="admin-security-note">Bu ekran route bilgisini yalnız seçim bağlamı olarak kullanır. Gerçek yetkilendirme her backend API çağrısında tekrar yapılacaktır.</p>
        </section>
    }
</section>

@code {
    [Parameter]
    public long CafeId { get; set; }

    private bool _isLoading = true;
    private AdminCafeListStatus _status;
    private AdminCafeResponse? _cafe;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _cafe = null;

        var result = await AdminCafeApiClient.GetMyCafesAsync(CancellationToken.None);
        _status = result.Status;
        _cafe = result.Status == AdminCafeListStatus.Success
            ? result.Cafes.SingleOrDefault(cafe => cafe.Id == CafeId)
            : null;

        _isLoading = false;
    }

}
