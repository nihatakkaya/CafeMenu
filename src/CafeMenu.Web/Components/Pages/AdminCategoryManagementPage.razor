@page "/admin/cafes/{CafeId:long}/categories"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IAdminCafeApiClient AdminCafeApiClient
@inject IAdminCategoryApiClient AdminCategoryApiClient

<PageTitle>Kategoriler</PageTitle>

<section class="admin-page admin-category-page">
    @if (_isLoading)
    {
        <section class="admin-state" aria-live="polite">
            <h1>Yükleniyor</h1>
            <p>Kategori yönetimi hazırlanıyor.</p>
        </section>
    }
    else if (_accessLoadFailed)
    {
        <section class="admin-state admin-state-warning" role="alert">
            <h1>Cafe erişimi doğrulanamadı</h1>
            <p>Şu anda cafe erişimi kontrol edilemiyor. Lütfen daha sonra tekrar deneyin.</p>
        </section>
    }
    else if (_cafe is null)
    {
        <section class="admin-state admin-state-denied" role="alert">
            <h1>Erişim yok</h1>
            <p>Bu cafe hesabınız için erişilebilir değil veya artık yönetilebilir durumda değil.</p>
        </section>
    }
    else
    {
        <AdminCafeHeader
            Cafe="_cafe"
            ActiveSection="AdminCafeSection.Categories"
            Kicker="Kategori Yönetimi"
            Summary="Kategorileri oluşturun, düzenleyin, görünürlüğünü değiştirin ve sıralayın." />

        @if (!string.IsNullOrWhiteSpace(_pageMessage))
        {
            <section class="@_pageMessageCssClass" role="status">@_pageMessage</section>
        }

        <EditForm Model="_categoryActionModel" OnSubmit="HandleCategoryActionAsync" FormName="CategoryActionForm" id="CategoryActionForm" method="post" class="admin-action-form"></EditForm>

        <section class="admin-panel">
            <h2>Yeni kategori</h2>
            <EditForm Model="_createModel" OnValidSubmit="CreateCategoryAsync" FormName="CreateCategoryForm" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="admin-form-grid">
                    <label>
                        Ad
                        <InputText @bind-Value="_createModel.Name" maxlength="160" />
                    </label>
                    <label>
                        Sıralama
                        <InputNumber @bind-Value="_createModel.DisplayOrder" />
                    </label>
                    <label class="admin-form-wide">
                        Açıklama
                        <InputTextArea @bind-Value="_createModel.Description" maxlength="1000" />
                    </label>
                    <label class="admin-form-wide">
                        Görsel URL
                        <InputText @bind-Value="_createModel.ImageUrl" maxlength="500" />
                    </label>
                    <label class="admin-check">
                        <InputCheckbox @bind-Value="_createModel.IsVisible" />
                        Görünür
                    </label>
                </div>

                <button class="admin-primary-button" type="submit" disabled="@_isMutating">Kategori oluştur</button>
            </EditForm>
        </section>

        <section class="admin-panel">
            <div class="admin-list-header">
                <h2>Kategoriler</h2>
                <a class="admin-secondary-button" href="@CurrentCategoryRoute">Yenile</a>
            </div>

            @if (_categoryLoadFailed)
            {
                <section class="admin-state admin-state-warning" role="alert">
                    <h3>Kategoriler yüklenemedi</h3>
                    <p>Şu anda kategori listesi alınamıyor.</p>
                </section>
            }
            else if (_categories.Count == 0)
            {
                <section class="admin-state">
                    <h3>Henüz kategori yok</h3>
                    <p>Bu cafe için ilk kategoriyi oluşturabilirsiniz.</p>
                </section>
            }
            else
            {
                <div class="admin-category-list">
                    @foreach (var category in _categories)
                    {
                        <article class="admin-category-item">
                            @if (_editingCategoryId == category.Id)
                            {
                                <EditForm Model="_editModel" OnValidSubmit="UpdateCategoryAsync" FormName="UpdateCategoryForm" method="post">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />
                                    <input type="hidden" name="_editModel.CategoryId" value="@_editModel.CategoryId" />

                                    <div class="admin-form-grid">
                                        <label>
                                            Ad
                                            <InputText @bind-Value="_editModel.Name" maxlength="160" />
                                        </label>
                                        <label>
                                            Sıralama
                                            <InputNumber @bind-Value="_editModel.DisplayOrder" />
                                        </label>
                                        <label class="admin-form-wide">
                                            Açıklama
                                            <InputTextArea @bind-Value="_editModel.Description" maxlength="1000" />
                                        </label>
                                        <label class="admin-form-wide">
                                            Görsel URL
                                            <InputText @bind-Value="_editModel.ImageUrl" maxlength="500" />
                                        </label>
                                    </div>

                                    <div class="admin-actions">
                                        <button class="admin-primary-button" type="submit" disabled="@_isMutating">Kaydet</button>
                                        <button class="admin-secondary-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildCategoryAction("CancelEdit", category.Id)" disabled="@_isMutating">Vazgeç</button>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <div class="admin-category-content">
                                    <div>
                                        <h3>@category.Name</h3>
                                        @if (!string.IsNullOrWhiteSpace(category.Description))
                                        {
                                            <p>@category.Description</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                                        {
                                            <a class="admin-image-reference" href="@category.ImageUrl" target="_blank" rel="noopener noreferrer">Görsel referansı</a>
                                        }
                                    </div>
                                    <div class="admin-category-meta">
                                        <span class="admin-badge admin-badge-muted">Sıra @category.DisplayOrder</span>
                                        <span class="@GetVisibleBadgeClass(category.IsVisible)">@GetVisibleLabel(category.IsVisible)</span>
                                        <span class="@GetPublishedBadgeClass(category.IsPublished)">@GetPublishedLabel(category.IsPublished)</span>
                                    </div>
                                </div>

                                @if (_pendingDeleteCategoryId == category.Id)
                                {
                                    <div class="admin-confirm" role="alert">
                                        <p>@category.Name kategorisi soft-delete ile silinecek. Onaylıyor musunuz?</p>
                                        <div class="admin-actions">
                                            <button class="admin-danger-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildCategoryAction("Delete", category.Id)" disabled="@_isMutating">Sil</button>
                                            <button class="admin-secondary-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildCategoryAction("CancelDelete", category.Id)" disabled="@_isMutating">Vazgeç</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="admin-actions">
                                        <button class="admin-secondary-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildCategoryAction("Edit", category.Id)" disabled="@_isMutating">Düzenle</button>
                                        <button class="admin-secondary-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildVisibilityAction(category)" disabled="@_isMutating">@GetVisibilityActionLabel(category.IsVisible)</button>
                                        <button class="admin-secondary-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildPublicationAction(category)" disabled="@_isMutating">@GetPublicationActionLabel(category.IsPublished)</button>
                                        <button class="admin-secondary-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildMoveAction(category, -1)" disabled="@IsMoveUpDisabled(category)">Yukarı</button>
                                        <button class="admin-secondary-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildMoveAction(category, 1)" disabled="@IsMoveDownDisabled(category)">Aşağı</button>
                                        <button class="admin-danger-button" type="submit" form="CategoryActionForm" name="_categoryActionModel.Action" value="@BuildCategoryAction("ConfirmDelete", category.Id)" disabled="@_isMutating">Sil</button>
                                    </div>
                                }
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    [Parameter]
    public long CafeId { get; set; }

    private bool _isLoading = true;
    private bool _isMutating;
    private bool _accessLoadFailed;
    private bool _categoryLoadFailed;
    private string? _pageMessage;
    private string _pageMessageCssClass = "admin-message";
    private AdminCafeResponse? _cafe;
    private IReadOnlyList<AdminCategoryResponse> _categories = [];
    private AdminCategoryFormModel _createModel = new();
    private AdminCategoryFormModel _editModel = new();
    private AdminCategoryActionFormModel _categoryActionModel = new();
    private long? _editingCategoryId;
    private long? _pendingDeleteCategoryId;

    [SupplyParameterFromForm(FormName = "CreateCategoryForm", Name = "_createModel")]
    private AdminCategoryFormModel? CreateFormModel { get; set; }

    [SupplyParameterFromForm(FormName = "UpdateCategoryForm", Name = "_editModel")]
    private AdminCategoryFormModel? UpdateFormModel { get; set; }

    [SupplyParameterFromForm(FormName = "CategoryActionForm", Name = "_categoryActionModel")]
    private AdminCategoryActionFormModel? CategoryActionFormModel { get; set; }

    private string CurrentCategoryRoute => $"/admin/cafes/{CafeId}/categories";

    protected override async Task OnParametersSetAsync()
    {
        ResetPageState();
        _createModel = CreateFormModel ?? new AdminCategoryFormModel();
        _editModel = UpdateFormModel ?? new AdminCategoryFormModel();
        _categoryActionModel = CategoryActionFormModel ?? new AdminCategoryActionFormModel();

        if (_editModel.CategoryId > 0)
        {
            _editingCategoryId = _editModel.CategoryId;
        }

        var cafeResult = await AdminCafeApiClient.GetMyCafesAsync(CancellationToken.None);
        if (cafeResult.Status == AdminCafeListStatus.Failure)
        {
            _accessLoadFailed = true;
            _isLoading = false;
            return;
        }

        _cafe = cafeResult.Cafes.SingleOrDefault(cafe => cafe.Id == CafeId);
        if (_cafe is null)
        {
            _isLoading = false;
            return;
        }

        await LoadCategoriesAsync();
        _isLoading = false;
    }

    private async Task LoadCategoriesAsync()
    {
        if (_cafe is null)
        {
            return;
        }

        _categoryLoadFailed = false;
        var result = await AdminCategoryApiClient.GetCategoriesAsync(_cafe.Id, CancellationToken.None);
        if (result.Status == AdminCategoryRequestStatus.Success)
        {
            _categories = SortCategories(result.Categories);
            return;
        }

        _categories = [];
        _categoryLoadFailed = true;
    }

    private async Task CreateCategoryAsync()
    {
        if (_cafe is null)
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            var result = await AdminCategoryApiClient.CreateCategoryAsync(
                new AdminCreateCategoryRequest(
                    _cafe.Id,
                    _createModel.Name,
                    NormalizeOptionalText(_createModel.Description),
                    NormalizeOptionalText(_createModel.ImageUrl),
                    _createModel.DisplayOrder,
                    _createModel.IsVisible),
                CancellationToken.None);

            if (result.Status == AdminCategoryRequestStatus.Success)
            {
                _createModel = new AdminCategoryFormModel();
                await LoadCategoriesAsync();
                SetSuccessMessage("Kategori oluşturuldu.");
                return;
            }

            SetMutationFailureMessage(result.Status, "Kategori oluşturulamadı.");
        });
    }

    private void BeginEdit(AdminCategoryResponse category)
    {
        _editingCategoryId = category.Id;
        _pendingDeleteCategoryId = null;
        _editModel = AdminCategoryFormModel.FromCategory(category);
        ClearMessage();
    }

    private void CancelEdit()
    {
        _editingCategoryId = null;
        _editModel = new AdminCategoryFormModel();
    }

    private async Task UpdateCategoryAsync()
    {
        if (_cafe is null || _editModel.CategoryId <= 0)
        {
            return;
        }

        var categoryId = _editModel.CategoryId;
        await RunMutationAsync(async () =>
        {
            var result = await AdminCategoryApiClient.UpdateCategoryAsync(
                categoryId,
                new AdminUpdateCategoryRequest(
                    _cafe.Id,
                    _editModel.Name,
                    NormalizeOptionalText(_editModel.Description),
                    NormalizeOptionalText(_editModel.ImageUrl),
                    _editModel.DisplayOrder),
                CancellationToken.None);

            if (result.Status == AdminCategoryRequestStatus.Success)
            {
                _editingCategoryId = null;
                _editModel = new AdminCategoryFormModel();
                await LoadCategoriesAsync();
                SetSuccessMessage("Kategori güncellendi.");
                return;
            }

            SetMutationFailureMessage(result.Status, "Kategori güncellenemedi.");
        });
    }

    private async Task HandleCategoryActionAsync(EditContext editContext)
    {
        if (_cafe is null || string.IsNullOrWhiteSpace(_categoryActionModel.Action))
        {
            return;
        }

        var parts = _categoryActionModel.Action.Split('|', StringSplitOptions.TrimEntries);
        if (parts.Length < 2 || !long.TryParse(parts[1], out var categoryId))
        {
            return;
        }

        var category = _categories.SingleOrDefault(item => item.Id == categoryId);
        if (category is null)
        {
            return;
        }

        switch (parts[0])
        {
            case "Edit":
                BeginEdit(category);
                break;
            case "CancelEdit":
                CancelEdit();
                break;
            case "ConfirmDelete":
                ConfirmDelete(category.Id);
                break;
            case "CancelDelete":
                CancelDelete();
                break;
            case "Delete":
                await DeleteCategoryAsync(category.Id);
                break;
            case "Visibility" when parts.Length == 3 && bool.TryParse(parts[2], out var isVisible):
                await ChangeVisibilityAsync(category, isVisible);
                break;
            case "Publication" when parts.Length == 3 && bool.TryParse(parts[2], out var isPublished):
                await ChangePublicationAsync(category, isPublished);
                break;
            case "Move" when parts.Length == 3 && int.TryParse(parts[2], out var direction):
                await MoveCategoryAsync(category, direction);
                break;
        }
    }

    private async Task ChangeVisibilityAsync(AdminCategoryResponse category, bool isVisible)
    {
        if (_cafe is null)
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            var result = await AdminCategoryApiClient.ChangeCategoryVisibilityAsync(
                category.Id,
                new AdminChangeCategoryVisibilityRequest(_cafe.Id, isVisible),
                CancellationToken.None);

            if (result.Status == AdminCategoryRequestStatus.Success)
            {
                await LoadCategoriesAsync();
                SetSuccessMessage("Kategori görünürlüğü güncellendi.");
                return;
            }

            SetMutationFailureMessage(result.Status, "Kategori görünürlüğü güncellenemedi.");
        });
    }

    private async Task ChangePublicationAsync(AdminCategoryResponse category, bool isPublished)
    {
        if (_cafe is null)
        {
            return;
        }

        await RunMutationAsync(async () =>
        {
            var result = await AdminCategoryApiClient.ChangeCategoryPublicationAsync(
                category.Id,
                new AdminChangeCategoryPublicationRequest(_cafe.Id, isPublished),
                CancellationToken.None);

            if (result.Status == AdminCategoryRequestStatus.Success)
            {
                await LoadCategoriesAsync();
                SetSuccessMessage(GetPublicationSuccessMessage(isPublished));
                return;
            }

            SetMutationFailureMessage(result.Status, "Kategori yayın durumu güncellenemedi.");
        });
    }

    private void ConfirmDelete(long categoryId)
    {
        _pendingDeleteCategoryId = categoryId;
        _editingCategoryId = null;
        ClearMessage();
    }

    private void CancelDelete()
    {
        _pendingDeleteCategoryId = null;
    }

    private async Task DeleteCategoryAsync(long categoryId)
    {
        await RunMutationAsync(async () =>
        {
            var result = await AdminCategoryApiClient.DeleteCategoryAsync(categoryId, CancellationToken.None);

            if (result.Status == AdminCategoryRequestStatus.Success)
            {
                _pendingDeleteCategoryId = null;
                await LoadCategoriesAsync();
                SetSuccessMessage("Kategori silindi.");
                return;
            }

            SetErrorMessage("Kategori silinemedi.");
        });
    }

    private async Task MoveCategoryAsync(AdminCategoryResponse category, int direction)
    {
        if (_cafe is null)
        {
            return;
        }

        var items = _categories.ToList();
        var currentIndex = items.FindIndex(item => item.Id == category.Id);
        var targetIndex = currentIndex + direction;

        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= items.Count)
        {
            return;
        }

        (items[currentIndex], items[targetIndex]) = (items[targetIndex], items[currentIndex]);
        var request = new AdminReorderCategoriesRequest(
            _cafe.Id,
            items
                .Select((item, index) => new AdminCategoryOrderRequest(item.Id, index))
                .ToArray());

        await RunMutationAsync(async () =>
        {
            var result = await AdminCategoryApiClient.ReorderCategoriesAsync(request, CancellationToken.None);

            if (result.Status == AdminCategoryRequestStatus.Success)
            {
                _categories = SortCategories(result.Categories);
                SetSuccessMessage("Kategori sıralaması güncellendi.");
                return;
            }

            SetErrorMessage("Kategori sıralaması güncellenemedi.");
        });
    }

    private bool IsMoveUpDisabled(AdminCategoryResponse category)
    {
        return _isMutating || _categories.Count == 0 || _categories[0].Id == category.Id;
    }

    private bool IsMoveDownDisabled(AdminCategoryResponse category)
    {
        return _isMutating || _categories.Count == 0 || _categories[^1].Id == category.Id;
    }

    private async Task RunMutationAsync(Func<Task> operation)
    {
        _isMutating = true;
        ClearMessage();

        try
        {
            await operation();
        }
        finally
        {
            _isMutating = false;
        }
    }

    private void ResetPageState()
    {
        _isLoading = true;
        _isMutating = false;
        _accessLoadFailed = false;
        _categoryLoadFailed = false;
        _cafe = null;
        _categories = [];
        ClearMessage();
    }

    private void SetMutationFailureMessage(AdminCategoryRequestStatus status, string fallbackMessage)
    {
        if (status == AdminCategoryRequestStatus.ValidationError)
        {
            SetErrorMessage("Form alanlarını kontrol edin. Backend doğrulaması isteği reddetti.");
            return;
        }

        SetErrorMessage(fallbackMessage);
    }

    private void SetSuccessMessage(string message)
    {
        _pageMessage = message;
        _pageMessageCssClass = "admin-message admin-message-success";
    }

    private void SetErrorMessage(string message)
    {
        _pageMessage = message;
        _pageMessageCssClass = "admin-message admin-message-error";
    }

    private void ClearMessage()
    {
        _pageMessage = null;
        _pageMessageCssClass = "admin-message";
    }

    private static IReadOnlyList<AdminCategoryResponse> SortCategories(IReadOnlyCollection<AdminCategoryResponse> categories)
    {
        return categories
            .OrderBy(category => category.DisplayOrder)
            .ThenBy(category => category.Name, StringComparer.Ordinal)
            .ThenBy(category => category.Id)
            .ToArray();
    }

    private static string? NormalizeOptionalText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static string BuildCategoryAction(string action, long categoryId)
    {
        return $"{action}|{categoryId}";
    }

    private static string BuildVisibilityAction(AdminCategoryResponse category)
    {
        return $"Visibility|{category.Id}|{!category.IsVisible}";
    }

    private static string BuildPublicationAction(AdminCategoryResponse category)
    {
        return $"Publication|{category.Id}|{!category.IsPublished}";
    }

    private static string BuildMoveAction(AdminCategoryResponse category, int direction)
    {
        return $"Move|{category.Id}|{direction}";
    }

    private static string GetPublishedLabel(bool isPublished)
    {
        return isPublished ? "Yayında" : "Taslak";
    }

    private static string GetVisibleLabel(bool isVisible)
    {
        return isVisible ? "Görünür" : "Gizli";
    }

    private static string GetVisibilityActionLabel(bool isVisible)
    {
        return isVisible ? "Gizle" : "Görünür yap";
    }

    private static string GetPublicationActionLabel(bool isPublished)
    {
        return isPublished ? "Yayından kaldır" : "Yayınla";
    }

    private static string GetPublicationSuccessMessage(bool isPublished)
    {
        return isPublished ? "Kategori yayına alındı." : "Kategori yayından kaldırıldı.";
    }

    private static string GetPublishedBadgeClass(bool isPublished)
    {
        return isPublished
            ? "admin-badge admin-badge-info"
            : "admin-badge admin-badge-muted";
    }

    private static string GetVisibleBadgeClass(bool isVisible)
    {
        return isVisible
            ? "admin-badge admin-badge-success"
            : "admin-badge admin-badge-muted";
    }
}
